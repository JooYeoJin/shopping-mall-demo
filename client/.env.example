# 프로덕션 빌드에서 API 서버 URL (개발 시 Vite proxy, 비우면 상대 경로 /api)
VITE_API_URL=

# Cloudinary Upload Widget (unsigned upload preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# 포트원 가맹점 식별코드 (콘솔 연동 정보). 서버 PORTONE_API_KEY/SECRET 과 반드시 같은 계정
# 미설정 시 샘플 코드(imp75955362)로 결제되어 REST 검증이 "존재하지 않는 결제정보"로 실패할 수 있음
# VITE_PORTONE_IMP_CODE=imp00000000

# PG (기본: KG이니시스 테스트) — 포트원 콘솔에서 연동한 PG MID로 교체
# VITE_PORTONE_PG=html5_inicis.INIpayTest
# VITE_PORTONE_PG_NAVER=naverco.NAVER_INICIS
# VITE_PORTONE_PG_KAKAO=kakaopay.TC0ONETIME
# VITE_PORTONE_PG_TOSS=tosspay
