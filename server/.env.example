PORT=5000
MONGODB_ATLAS_URI=
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Vercel 프론트 origin. 여러 개면 콤마로 구분. 비우면 모든 origin 허용
# CORS_ORIGIN=https://your-app.vercel.app

# 포트원 REST API (결제 검증) — 포트원 콘솔 > 연동 정보 > REST API Key / Secret
# PORTONE_API_KEY=
# PORTONE_API_SECRET=
